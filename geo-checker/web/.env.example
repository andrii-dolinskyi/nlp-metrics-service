# Copy to .env (or set in your hosting panel) — never commit real values

# Required: the n8n scoring webhook (production URL)
N8N_WEBHOOK_URL=https://n8n-test.snoika.com/webhook/ai-visibility-check

# Strongly recommended: enable Header Auth on the n8n webhook node
# (credential: header name X-Snoika-Key) and put the same secret here.
# Generate one with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Optional: Cloudflare Turnstile (invisible CAPTCHA). Create a widget at
# dash.cloudflare.com -> Turnstile, then set both keys. If unset, the
# CAPTCHA step is skipped and rate limiting alone protects the endpoint.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional tuning
PORT=3000
RATE_PER_HOUR=6
RATE_PER_DAY=20
CACHE_TTL_HOURS=24
