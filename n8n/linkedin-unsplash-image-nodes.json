    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\n\nlet sel = sd.currentSelection || {};\nif (!sel.link) {\n  try { sel = $('Select Article').first().json || {}; } catch (e) {}\n}\n\nconst out = ($input.first().json.output) || {};\nconst post = String(out.post || '').trim();\nconst headline = String(out.headline || sel.title || '').trim();\n\n// Carry the image query forward so nothing downstream has to reach back\n// across the approval wait node to read it off News Reporter.\nconst imageQuery = String(out.image_query || '').trim() || 'business technology';\n\nif (!post) {\n  throw new Error('News Reporter returned an empty post.');\n}\n\nlet attempt = sd.attemptCount || 0;\nif (attempt === 0) {\n  try { attempt = $('Select Article').first().json.attempt || 1; } catch (e) { attempt = 1; }\n}\n\nreturn [{ json: {\n  headline: headline,\n  post: post,\n  imageQuery: imageQuery,\n  title: sel.title || '',\n  link: sel.link || '',\n  attempt: attempt,\n} }];"
      },
