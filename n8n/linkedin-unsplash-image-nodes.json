    {
      "parameters": {
        "jsCode": "// Picks one Unsplash photo and builds a LinkedIn-sized crop URL.\n// The crop is done by Unsplash's imgix CDN, so it costs nothing and needs no image library.\n//\n// LinkedIn single-image feed post: 1200 x 627 (1.91:1) is LinkedIn's recommended size.\n// Prefer more feed real estate? Use 1200 x 1200 (square) or 1200 x 1500 (4:5).\nconst TARGET_W = 1200;\nconst TARGET_H = 627;\nconst QUALITY = 80;\n\nconst post = $('Format Post').first().json;\nconst res = $input.first().json || {};\nconst results = Array.isArray(res.results) ? res.results : [];\n\nfunction sized(rawUrl, w, h, q) {\n  const sep = rawUrl.includes('?') ? '&' : '?';\n  return rawUrl + sep + 'fm=jpg&cs=srgb&auto=compress&fit=crop&crop=faces,entropy'\n    + '&w=' + w + '&h=' + h + '&q=' + q;\n}\n\n// Keep photos wide enough for a clean 1200px crop, in Unsplash relevance order\nconst usable = results.filter(p =>\n  p && p.urls && p.urls.raw && (p.width || 0) >= TARGET_W && (p.width || 0) >= (p.height || 0)\n);\nconst photo = usable[0] || results.find(p => p && p.urls && p.urls.raw) || null;\n\nif (!photo) {\n  return [{ json: {\n    ...post,\n    hasImage: false,\n    imageUrl: '',\n    imagePreviewUrl: '',\n    imageCredit: '',\n    imageCreditUrl: '',\n    downloadLocation: '',\n  } }];\n}\n\nconst author = (photo.user && photo.user.name) || 'Unsplash';\nconst authorUrl = (photo.user && photo.user.links && photo.user.links.html) || 'https://unsplash.com';\nconst utm = '?utm_source=n8n_linkedin_bot&utm_medium=referral';\n\nreturn [{ json: {\n  ...post,\n  hasImage: true,\n  imageId: photo.id,\n  imageUrl: sized(photo.urls.raw, TARGET_W, TARGET_H, QUALITY),\n  imagePreviewUrl: sized(photo.urls.raw, 800, Math.round(800 * TARGET_H / TARGET_W), 70),\n  imageAlt: photo.alt_description || '',\n  imageCredit: 'Photo by ' + author + ' on Unsplash',\n  imageCreditUrl: authorUrl + utm,\n  downloadLocation: (photo.links && photo.links.download_location) || '',\n} }];"
      },
